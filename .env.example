# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/CommunityWebApp
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/CommunityWebApp
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/CommunityWebApp


# JWT Configuration (kept for migration compatibility)
JWT_SECRET=your-secret-key-here

# Social Authentication (Optional)
# GitHub OAuth App: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary Configuration (for image uploads)
CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Server Configuration
PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# Resend (marketplace contact relay email)
RESEND_API_KEY=re_xxxxxxxxxxxx
SENDING_FROM_EMAIL=Mahalle <noreply@mahalle.berlin>
CONTACT_IP_SALT=some-random-secret-salt
ALLOWED_ORIGINS=https://mahalle.berlin

# Sentry Error Monitoring
# DSN is a public ingest identifier (not a secret). AUTH_TOKEN is
# SERVER-ONLY — never expose to the client; needed for the admin
# errors widget + sourcemap uploads. Org/project: sentry.io slugs.
SENTRY_DSN=your-sentry-dsn-here
# Same value as SENTRY_DSN above — server code reads the bare name, but
# the client bundle can only see PUBLIC_-prefixed vars. Both are the
# public ingest URL, not secrets.
PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-org-slug-here
SENTRY_PROJECT=your-project-slug-here
# Optional. Set per Vercel environment scope (production/preview) so
# client-side events tag their true environment instead of inlining
# MODE='production' (always true for any build) — prevents preview
# errors from masquerading as production.
PUBLIC_VERCEL_ENV=

# Read-only demo deployment (2026-10-26). `1` ONLY on the `demo` branch's Vercel preview scope,
# never here, never in Production. Fail-closed: without a database whose name matches /dev/i the
# flag does nothing. See CLAUDE.md → „Demo deployment".
# DEMO_MODE=

# Impressum — ladungsfähige Anschrift (SSR-only, rendered obfuscated; never commit real values)
IMPRESSUM_STREET=
IMPRESSUM_ZIP_CITY=
