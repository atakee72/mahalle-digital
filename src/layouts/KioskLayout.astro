---
// Editorial Kiosk layout — replaces dark-glass for Forum (and eventually
// the rest of the app, batch by batch). Use this for any page that should
// render in the new visual identity.
//
// What's NOT here (vs BaseLayout):
//   - SplashScreen          (Kiosk variant TBD; opt-in later)
//   - GlassFilters          (dark-glass-only SVG displacement filters)
//   - low-perf detector     (no heavy filters in Kiosk)
//
// Body background uses `.k-paper-bg` — cream paper + subtle risograph grain.
import { getSession } from 'auth-astro/server';
import KioskNav from '../components/forum/kiosk/KioskNav.svelte';
import KioskFooter from '../components/forum/kiosk/KioskFooter.svelte';
import VerifyEmailBanner from '../components/auth/kiosk/VerifyEmailBanner.svelte';
import SuspendedBanner from '../components/auth/kiosk/SuspendedBanner.svelte';
import ToastProvider from '../components/ToastProvider';
import TourController from '../components/tour/TourController.svelte';
import SeoHead from '../components/SeoHead.astro';
import { ViewTransitions } from 'astro:transitions';

const session = await getSession(Astro.request);
const currentPath = Astro.url.pathname;

export interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Real pixel size of `image` — pass ONLY when known (dedicated link-preview assets). */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  page?: 'forum' | 'calendar' | 'marketplace' | 'newsboard' | 'profile' | 'blog' | 'admin' | 'schillerkiez' | 'auth';
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string | null;
  article?: { publishedTime: string; modifiedTime?: string; author?: string; tags?: string[] };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Mahalle — die digitale Nachbarschaft für den Schillerkiez.',
  image = '/og-image.png',
  imageWidth,
  imageHeight,
  imageAlt,
  page,
  type = 'website',
  noindex = false,
  canonicalPath,
  article,
  jsonLd,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3ead8" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="generator" content={Astro.generator} />

    <SeoHead
      title={`${title} | Mahalle`}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      canonicalPath={canonicalPath}
      article={article}
      jsonLd={jsonLd}
    />

    <title>{title} | Mahalle</title>

    <ViewTransitions />
  </head>

  <body
    class="min-h-screen k-paper-bg text-ink font-bricolage antialiased flex flex-col"
    data-page={page}
  >
    <KioskNav client:load currentPath={currentPath} user={session?.user ?? null} />
    {session?.user && <SuspendedBanner client:load />}
    {session?.user && session.user.emailVerified !== true && <VerifyEmailBanner client:load />}
    <ToastProvider client:load />
    <TourController client:load user={session?.user ?? null} page={page} />

    <main class="flex-1">
      <slot />
    </main>

    <KioskFooter client:load />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
