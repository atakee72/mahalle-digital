---
// Editorial Kiosk layout for the logged-out front door (login · register).
// Sibling to KioskLayout, but WITHOUT the full app nav — a logged-out visitor
// shouldn't see Forum/Calendar/… links. Slim masthead + centered card on paper.
import AuthLangToggle from '../components/auth/kiosk/AuthLangToggle.svelte';
import KiezHeartbeat from '../components/auth/kiosk/KiezHeartbeat.svelte';
import KioskSplash from '../components/auth/kiosk/KioskSplash.astro';
import SeoHead from '../components/SeoHead.astro';
import { ViewTransitions } from 'astro:transitions';
import GoatCounter from '../components/GoatCounter.astro';
import DemoHead from '../components/demo/DemoHead.astro';

export interface Props {
  title: string;
  description?: string;
  /** Link-preview copy only (og/twitter) — the tab title and meta description stay.
   *  `image` (with its real pixel size) replaces the default 1200×630 og-image, e.g. the square
   *  invitation plate for /register?invite=… (chat apps crop a wide image to a square thumbnail). */
  card?: { title: string; description: string; image?: string; imageWidth?: number; imageHeight?: number; imageAlt?: string } | null;
}

const {
  title,
  description = 'Mahalle — die digitale Nachbarschaft für den Schillerkiez.',
  card = null,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3ead8" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Mahalle</title>
    <SeoHead
      title={card?.title ?? `${title} | Mahalle`}
      description={card?.description ?? description}
      image={card?.image}
      imageWidth={card?.imageWidth}
      imageHeight={card?.imageHeight}
      imageAlt={card?.imageAlt}
      noindex={true}
    />
    <ViewTransitions />
    <GoatCounter />
    <DemoHead />
  </head>

  <body
    class="min-h-screen k-paper-bg text-ink font-bricolage antialiased flex flex-col"
    data-page="auth"
  >
    <KioskSplash />
    <!-- slim auth masthead: monogram + wordmark + region + DE/EN -->
    <header class="flex items-center justify-between" style="padding:18px 32px; border-bottom:1px dashed var(--k-rule);">
      <a href="/" class="flex items-center no-underline kiosk-tap" style="gap:10px; color:var(--k-ink);">
        <span class="font-instrument" style="width:34px; height:34px; background:var(--k-ochre); border-radius:50%; border:2px solid var(--k-ink); transform:rotate(-4deg); display:flex; align-items:center; justify-content:center; font-style:italic; font-size:20px; color:var(--k-ink); position:relative;">m<!-- the Mahalle ladybird hugs the disc at 2 o'clock, as on the main logo (2026-11-25; root CLAUDE.md → „Page-change loader"). No paper halo: the ground here is paper. --><svg data-logo-bug aria-hidden="true" viewBox="-7.5 -9.5 21 14" style="position:absolute; width:90%; height:auto; left:83%; top:30%; overflow:visible; pointer-events:none; color:var(--k-ink); transform-origin:35.7% 89.3%; transform:translate(-35.7%, -89.3%) rotate(60deg) scaleX(-1);"><path d="M-3,0 L-5,2.5 M0,0.5 L0,3 M3,0 L5,2.5 M6,-3.5 Q9,-8 10,-8 M7,-2.5 Q11,-5 12,-4.5" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="6.2" cy="-2" r="2.6" fill="currentColor" /><path d="M-6,0 A6,5 0 0 1 6,0 Z" fill="#DB472D" stroke="currentColor" stroke-width="0.75" stroke-linejoin="round" /><path d="M0,0 L0,-5" fill="none" stroke="currentColor" stroke-width="0.7" stroke-linecap="round" /><g fill="currentColor"><circle cx="-3" cy="-2" r="0.95" /><circle cx="2.6" cy="-2.8" r="0.95" /><circle cx="3.3" cy="-0.8" r="0.7" /></g></svg></span>
        <span class="font-bricolage" style="font-size:20px; font-weight:800; letter-spacing:-0.03em;">mahalle</span>
      </a>
      <div class="flex items-center" style="gap:14px;">
        <span class="font-dmmono hidden sm:inline" style="font-size:10px; color:var(--k-ink-mute); letter-spacing:0.12em;">SCHILLERKIEZ · NEUKÖLLN · BERLIN</span>
        <AuthLangToggle client:load />
      </div>
    </header>

    <main class="flex-1 flex items-center justify-center" style="padding:28px 22px;">
      <div style="width:100%; max-width:460px;">
        <slot />
      </div>
    </main>
    <footer class="flex justify-center" style="padding:0 0 26px;">
      <KiezHeartbeat client:load />
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
