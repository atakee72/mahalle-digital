---
// Editorial Kiosk layout for the internal admin back-office.
// Sibling to AuthLayout, but for the OPPOSITE audience: a logged-in admin,
// not a logged-out visitor. No KioskNav (this isn't part of the public app
// nav), no footer. Plum accent via [data-page="admin"] in tokens.css.
// The layout never calls getSession itself — each page resolves the session
// and passes `user` (name/image/role) for the masthead avatar + menu.
import AuthLangToggle from '../components/auth/kiosk/AuthLangToggle.svelte';
import AdmAvatar from '../components/admin/kiosk/AdmAvatar.svelte';
import ToastProvider from '../components/ToastProvider';
import { ViewTransitions } from 'astro:transitions';

export interface Props {
  title: string;
  user: { name?: string | null; image?: string | null; role?: string };
  wordmark?: string;   // masthead italic word — 'moderation' | 'amtliches' | …
  ribbonEcho?: string; // mono echo on the right of the internal-area ribbon
}

const {
  title,
  user,
  wordmark = 'moderation',
  ribbonEcho = 'user.role === "admin"',
} = Astro.props;

// Island props are serialized into the HTML for hydration — pass only what
// the avatar needs, never the whole session user (id/email would otherwise
// land in the page source).
const avatarUser = { name: user.name ?? null, image: user.image ?? null, role: user.role };

// Section rail (2026-09-09): the three admin pages are siblings, so the
// layout owns the navigation between them — before this, Amtliches and
// Mitglieder were reachable only by URL (the avatar menu links to
// /admin/moderation alone) and mobile had no back-link at all. Static DE,
// same locked decision as the ribbon. Active = current path prefix.
const ADMIN_SECTIONS = [
  { href: '/admin/moderation',    label: 'Moderation' },
  { href: '/admin/announcements', label: 'Amtliches' },
  { href: '/admin/mitglieder',    label: 'Mitglieder' },
] as const;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Mahalle — interne Moderationsoberfläche." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f3ead8" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
    <meta name="mh-nocount" content="1" />
  </head>

  <body
    class="min-h-screen k-paper-bg text-ink font-bricolage antialiased flex flex-col"
    data-page="admin"
  >
    <!-- ═══ Desktop (≥ md) masthead — full ribbon + branding + back-link + avatar menu. ═══ -->
    <div class="hidden md:block">
      <!-- Internal-area ribbon — static DE, locked decision (Task 1 brief). -->
      <div
        class="flex items-center justify-between font-dmmono"
        style="background:var(--k-accent); color:var(--k-paper); padding:6px 36px; font-size:10px; letter-spacing:0.14em;"
      >
        <span>INTERNER BEREICH — NUR FÜR ADMINS SICHTBAR</span>
        <span>{ribbonEcho}</span>
      </div>

      <header
        class="flex items-center justify-between"
        style="padding:18px 36px; border-bottom:1px dashed var(--k-rule);"
      >
        <div class="flex items-center" style="gap:12px;">
          <div
            class="font-instrument"
            style="width:42px; height:42px; background:var(--k-accent); border-radius:50%; border:2px solid var(--k-ink); display:flex; align-items:center; justify-content:center; font-style:italic; font-size:26px; color:var(--k-paper);"
          >m</div>
          <div>
            <div class="font-bricolage" style="font-size:22px; font-weight:800; letter-spacing:-0.03em; line-height:1;">
              mahalle <span class="font-instrument" style="font-style:italic; font-weight:400; color:var(--k-accent);">{wordmark}</span>
            </div>
            <div class="font-dmmono" style="font-size:9px; color:var(--k-ink-mute); letter-spacing:0.1em; margin-top:2px;">SCHILLERKIEZ · NEUKÖLLN · ADMIN</div>
          </div>
        </div>

        <div class="flex items-center" style="gap:14px;">
          <a href="/forum" class="font-dmmono no-underline" style="font-size:11px; color:var(--k-ink-mute);">← zum Forum</a>
          <AuthLangToggle client:load />
          <AdmAvatar client:load user={avatarUser} size={38} />
        </div>
      </header>

      <nav aria-label="Admin-Bereiche" class="flex font-dmmono" style="gap:28px; padding:10px 36px; border-bottom:1px dashed var(--k-rule); font-size:11px; letter-spacing:0.12em; text-transform:uppercase;">
        {ADMIN_SECTIONS.map(({ href, label }) => {
          const active = currentPath.startsWith(href);
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class="no-underline"
              style={`padding:2px 0; border-bottom:2px solid ${active ? 'var(--k-accent)' : 'transparent'}; color:${active ? 'var(--k-accent)' : 'var(--k-ink-mute)'}; font-weight:${active ? 700 : 400};`}
            >{label}</a>
          );
        })}
      </nav>
    </div>

    <!-- ═══ Mobile (< md) masthead — slim ribbon + compact wordmark. ═══
         Per JSX kiosk-admin.jsx:482-491. AuthLangToggle + the avatar menu
         (bottom sheet on this viewport) sit in this row; the section rail
         below carries section navigation (+ ← Forum). -->
    <div class="md:hidden">
      <div
        class="font-dmmono"
        style="background:var(--k-accent); color:var(--k-paper); padding:6px 18px; font-size:9px; letter-spacing:0.12em;"
      >INTERN · NUR ADMIN</div>

      <header
        class="flex items-center justify-between"
        style="padding:14px 18px; border-bottom:1px dashed var(--k-rule);"
      >
        <div class="flex items-center" style="gap:9px;">
          <div
            class="font-instrument"
            style="width:32px; height:32px; background:var(--k-accent); border-radius:50%; border:2px solid var(--k-ink); display:flex; align-items:center; justify-content:center; font-style:italic; font-size:19px; color:var(--k-paper);"
          >m</div>
          <div class="font-bricolage" style="font-size:17px; font-weight:800; letter-spacing:-0.02em;">{wordmark}</div>
        </div>

        <div class="flex items-center" style="gap:10px;">
          <AuthLangToggle client:load />
          <AdmAvatar client:load user={avatarUser} size={32} />
        </div>
      </header>

      <nav aria-label="Admin-Bereiche" class="no-scrollbar flex overflow-x-auto font-dmmono" style="gap:20px; padding:9px 18px; border-bottom:1px dashed var(--k-rule); font-size:10px; letter-spacing:0.12em; text-transform:uppercase; white-space:nowrap;">
        {ADMIN_SECTIONS.map(({ href, label }) => {
          const active = currentPath.startsWith(href);
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class="no-underline shrink-0"
              style={`padding:2px 0; border-bottom:2px solid ${active ? 'var(--k-accent)' : 'transparent'}; color:${active ? 'var(--k-accent)' : 'var(--k-ink-mute)'}; font-weight:${active ? 700 : 400};`}
            >{label}</a>
          );
        })}
        <a href="/forum" class="no-underline shrink-0" style="margin-left:auto; padding:2px 0; color:var(--k-ink-mute);">← Forum</a>
      </nav>
    </div>

    <main class="flex-1">
      <slot />
    </main>
    <ToastProvider client:load />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/admin.css';
</style>
