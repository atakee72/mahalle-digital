---
// Recommendation detail — Editorial Kiosk shell.
//
// Mirror of /topics/[id].astro, scoped to the `recommendations`
// collection. See announcements/[id].astro for the same shape.

import KioskLayout from '../../layouts/KioskLayout.astro';
import ForumPostDetail from '../../components/forum/kiosk/ForumPostDetail.svelte';
import { getSession } from 'auth-astro/server';
import { connectDB } from '../../lib/mongodb';
import { ObjectId } from 'mongodb';
import { buildModerationFilter, fetchRelatedForDetail, populateAuthors } from '../../lib/topicsQuery';
import { locatePost } from '../../lib/forum/movePost';
import { hrefForPost } from '../../lib/forum/postKind';

const { id } = Astro.params;

if (!id || !ObjectId.isValid(id)) {
  return Astro.redirect('/', 302);
}

const session = await getSession(Astro.request);
const currentUserId = session?.user?.id;

const db = await connectDB();
const collection = db.collection('recommendations');
const commentsCollection = db.collection('comments');

const filter: Record<string, any> = {
  _id: new ObjectId(id),
  ...buildModerationFilter(currentUserId)
};

const doc = await collection.findOne(filter);

if (!doc) {
  // See topics/[id].astro — moved post → 302 to its new collection.
  const elsewhere = await locatePost(db, id, 'recommendations');
  if (elsewhere) return Astro.redirect(hrefForPost(elsewhere, id), 302);
  return new Response('Not found', { status: 404 });
}

const [hydrated] = await populateAuthors([doc as any]);

const commentFilter: Record<string, any> = {
  relevantPostId: new ObjectId(id),
  $or: [
    { moderationStatus: 'approved' },
    { moderationStatus: { $exists: false } },
    { moderationStatus: 'pending', isUserReported: true },
    ...(currentUserId
      ? [
          { author: currentUserId, moderationStatus: 'pending' },
          { author: currentUserId, moderationStatus: 'rejected' }
        ]
      : [])
  ]
};

const rawComments = await commentsCollection
  .find(commentFilter)
  .sort({ date: -1 })
  .toArray();

const comments = await populateAuthors(rawComments as any[]);

const initialTopic = JSON.parse(JSON.stringify(hydrated));
const initialComments = JSON.parse(JSON.stringify(comments));
const related = await fetchRelatedForDetail('recommendations', doc as any);

const pageTitle = doc.title ? `${doc.title} · Mahalle Forum` : 'Mahalle Forum';
---

<KioskLayout title={pageTitle} description={doc.body?.slice(0, 160) ?? ''} page="forum">
  <ForumPostDetail
    client:only="svelte"
    initialTopic={initialTopic}
    initialComments={initialComments}
    currentUserId={currentUserId ?? null}
    currentUser={session?.user ? { name: session.user.name ?? null, image: session.user.image ?? null } : null}
    collectionType="recommendations"
    {related}
    isOfficial={initialTopic.isOfficial === true}
  />
</KioskLayout>
