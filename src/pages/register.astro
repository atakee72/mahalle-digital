---
import AuthLayout from '../layouts/AuthLayout.astro';
import AuthRegisterInner from '../components/auth/kiosk/AuthRegisterInner.svelte';
import { connectDB } from '../lib/mongodb';
import { resolveInvite } from '../lib/invites/invites';
import { normalizeInviteCode } from '../lib/invites/inviteRules';
import type { RegisterInvite } from '../components/auth/kiosk/registerInvite';
// Session-varying (logged-in members are bounced to /forum) — parity with reset/verify.
Astro.response.headers.set('Cache-Control', 'no-store, must-revalidate');

// Personal invitation link: /register?invite=<code>. Checked here so the visitor sees who
// invited them (or that the link is dead) before typing; the register route checks again on
// submit. A malformed code is dead without touching the database. A database hiccup must not
// take the register page down: the lookup gets 2.5 s (connectDB() alone may retry for ~20 s).
// A slow or failed lookup keeps the code in the form WITHOUT a banner (empty inviterName) and
// the route decides on submit (valid: recorded; dead: 400 invite_invalid, dead banner) - a
// code is never silently dropped. invite = null only when there is no ?invite= at all.
let invite: RegisterInvite | null = null;
const rawInvite = Astro.url.searchParams.get('invite');
if (rawInvite !== null) {
  const code = normalizeInviteCode(rawInvite);
  if (code === null) {
    invite = { dead: true };
  } else {
    let timer: ReturnType<typeof setTimeout> | undefined;
    try {
      const lookup = (async () => resolveInvite(await connectDB(), code))();
      lookup.catch(() => {}); // the losing branch must never surface as an unhandled rejection
      const inv = await Promise.race([
        lookup,
        new Promise<null>((resolve) => { timer = setTimeout(() => resolve(null), 2500); }),
      ]);
      invite = inv === null
        ? { code, inviterName: '' }
        : inv.ok
          ? { code, inviterName: inv.inviter.name }
          : { dead: true };
    } catch {
      invite = { code, inviterName: '' };
    } finally {
      clearTimeout(timer);
    }
  }
}

// Link preview for a shared invitation (WhatsApp, Signal, Telegram, LinkedIn fetch og:* server-side):
// its own title, a sentence that says what the link is, and a SQUARE plate — chat apps crop the
// wide default og-image to a square thumbnail, which cut the wordmark to „halle". Deliberately
// WITHOUT the inviter's name: the crawlers cache whatever they fetch; the name shows on the page.
// A dead link keeps the plain register card — it must not promise an invitation.
const card = invite && !invite.dead
  ? {
      title: 'Du bist eingeladen | Mahalle',
      description: 'Eine Einladung in die Nachbarschaft: Mahalle ist das Forum, der Kalender und der Markt für den Schillerkiez – ohne Werbung, ohne Datenhandel.',
      image: '/og-invite.png',
      imageWidth: 1200,
      imageHeight: 1200,
      imageAlt: 'Du bist eingeladen – Mahalle, die digitale Nachbarschaft für den Schillerkiez',
    }
  : null;
---

<AuthLayout title="Registrieren" card={card}>
  <AuthRegisterInner client:only="svelte" invite={invite} />
</AuthLayout>
