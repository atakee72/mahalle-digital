---
// /blog/tag/[tag] — SSR (Decision 1). Unknown/empty tags render the
// „Leere Rubrik" state (catches stale links) instead of 404ing.
import { getCollection } from 'astro:content';
import KioskLayout from '../../../layouts/KioskLayout.astro';
import BeilageTagPage from '../../../components/blog/kiosk/BeilageTagPage.svelte';
import { compareNewest, readingMinutes, tagCounts, type BeilagePost } from '../../../lib/blog/beilage';

const { tag = '' } = Astro.params;

// Session-varying SSR (KioskLayout reads the session for the nav) — never let a shared cache keep it.
Astro.response.headers.set('Cache-Control', 'no-store, must-revalidate');
const entries = await getCollection('blog', ({ data }) => !data.draft);
const all: BeilagePost[] = entries
  .map((e) => ({
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    pubDateISO: e.data.pubDate.toISOString(),
    author: e.data.author,
    tags: e.data.tags ?? [],
    layout: e.data.postLayout,
    minutes: readingMinutes(e.body ?? ''),
    cover: e.data.cover?.src,
    coverWidth: e.data.cover?.width,
    coverHeight: e.data.cover?.height,
    coverAlt: e.data.coverAlt,
    coverPosition: e.data.coverPosition,
  }))
  .sort(compareNewest);
const posts = all.filter((p) => p.tags.includes(tag));
---

<KioskLayout title={`Rubrik #${tag} — Die Beilage`} description={`Beiträge der Rubrik #${tag} in der Beilage.`} page="blog" noindex={posts.length === 0}>
  <BeilageTagPage client:only="svelte" tag={tag} posts={posts} allTags={tagCounts(all)} />
</KioskLayout>

<style is:global>
  @import '../../../styles/blog.css';
</style>
