---
// Shared article scaffold for all 3 postLayouts. The wrapping div
// `.bl-sheet` is the Druckbogen print-isolation root (Task 6).
import KioskLayout from '../../../layouts/KioskLayout.astro';
import BlogReadBar from './BlogReadBar.svelte';
import BlogArticleFooter from './BlogArticleFooter.svelte';
import BlogRelatedRail from './BlogRelatedRail.svelte';
import QRCode from 'qrcode';
import { getTrustedBaseUrl } from '../../../lib/auth/baseUrl';
import { fmtDate, type BeilagePost, type RelatedItem } from '../../../lib/blog/beilage';

interface Props {
  post: BeilagePost;
  related: RelatedItem[];
}
const { post, related } = Astro.props;

// getTrustedBaseUrl fails closed to '' in prod when NEXTAUTH_URL is unset —
// that protects EMAILED links; this route only prints a public URL into a
// QR. Fall back to the canonical domain (same literal as steckbrief.astro;
// mahalle.digital is live since 2026-08-09).
const baseUrl = getTrustedBaseUrl(Astro.request) || 'https://mahalle.digital';
const articleUrl = `${baseUrl}/blog/${post.id}`;
// SAFE to set:html — QRCode.toString output for a same-origin URL we
// construct ourselves; never user-supplied. Same pattern as steckbrief/druck.
const qrSvg = await QRCode.toString(articleUrl, {
  type: 'svg',
  margin: 0,
  color: { dark: '#1b1a17', light: '#0000' },
});
const standDate = fmtDate(post.pubDateISO, 'de'); // print sheet is DE-only, like both existing print surfaces

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://mahalle.digital').href;
// Link preview: the dedicated 1200×630 asset when the post has one (its real size is declared), else the cover as-is, else the site default.
const ogImage = post.ogImage ?? post.cover ?? '/og-image.png'; // both are already processed asset path strings
const ogDims = post.ogImage && post.ogImageWidth && post.ogImageHeight ? { width: post.ogImageWidth, height: post.ogImageHeight } : undefined;
const authorName = post.author ?? 'Mahalle Team'; // schema default, for safety

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.pubDateISO,
  ...(post.updatedDateISO ? { dateModified: post.updatedDateISO } : {}),
  author: { '@type': 'Person', name: authorName },
  publisher: {
    '@type': 'Organization',
    name: 'Mahalle',
    url: 'https://mahalle.digital',
    logo: { '@type': 'ImageObject', url: 'https://mahalle.digital/icons/icon-512.png' },
  },
  mainEntityOfPage: canonicalUrl,
  inLanguage: 'de',
  ...(post.ogImage || post.cover ? { image: new URL((post.ogImage ?? post.cover) as string, Astro.site ?? 'https://mahalle.digital').href } : {}),
  ...(post.tags.length ? { keywords: post.tags.join(', ') } : {}),
};
---

<KioskLayout
  title={post.title}
  description={post.description}
  page="blog"
  type="article"
  image={ogImage}
  imageWidth={ogDims?.width}
  imageHeight={ogDims?.height}
  imageAlt={post.coverAlt}
  article={{
    publishedTime: post.pubDateISO,
    ...(post.updatedDateISO ? { modifiedTime: post.updatedDateISO } : {}),
    author: authorName,
  }}
  jsonLd={jsonLd}
>
  <BlogReadBar client:only="svelte" title={post.title} minutes={post.minutes} />
  <div class="bl-sheet">
    <div class="bl-print-head hidden">
      <div class="bl-print-strap">DIE BEILAGE · SCHILLERKIEZ KURIER</div>
    </div>
    <slot name="header" />
    <div class="max-w-[940px] mx-auto px-5 lg:px-0">
      <slot />
      <div class="bl-print-hide">
        <BlogArticleFooter client:only="svelte" post={post} />
      </div>
      <div class="bl-print-hide">
        <BlogRelatedRail client:only="svelte" items={related} />
      </div>
    </div>
    <div class="bl-print-foot hidden">
      <div class="bl-print-stand">STAND: {standDate}<br />{articleUrl.replace(/^https?:\/\//, '')}</div>
      <div class="bl-print-qr"><Fragment set:html={qrSvg} /></div>
    </div>
  </div>
</KioskLayout>

<style is:global>
  @import '../../../styles/blog.css';
  @import '../../../styles/blog-print.css';
</style>
