{
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/news/fetch-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-deletions",
      "schedule": "30 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
